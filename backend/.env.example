# Copy this file to .env and fill in real values there.
# .env is already in .gitignore — never commit it.
#
# This is the BACKEND's env file only. The Next.js frontend gets its own
# .env.local with NEXT_PUBLIC_FIREBASE_* client config (Vercel and Render are
# two separate deployments — they can't share one physical file — but every
# credential still lives in exactly one .env per app, nothing hardcoded).

# ---------------------------------------------------------------------------
# Provider fallback chain: Gemini (primary) -> Gemini (backup) -> Groq
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
GROQ_API_KEY=

# Ignored everywhere in the code right now. Set ENABLE_TOGETHER=true and ask
# me to wire it into providers.py when you actually want a 4th fallback.
ENABLE_TOGETHER=false
TOGETHER_API_KEY=

# Loaded but not called anywhere yet — here so every credential lives in one
# place once you decide where you want to use them.
HUGGINGFACE_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Model names — see the comments in config.py before changing these
# ---------------------------------------------------------------------------
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server-side)
# ---------------------------------------------------------------------------
# Path to the service-account JSON. Download from Firebase Console -> Project
# Settings -> Service Accounts -> Generate new private key. Put the actual
# file under ./secrets/ (already git-ignored) — never commit it, never paste
# its contents anywhere in chat.
# Path to the service-account JSON file (local dev / Render Secret Files).
FIREBASE_ADMIN_CREDENTIALS_PATH=./secrets/firebase-admin.json
# Alternative to the path above: paste the FULL service-account JSON here as
# one value instead (useful on hosts where uploading a separate file is
# awkward, e.g. v0). If both are set, this one wins. Never paste it in chat —
# only into this file / your host's environment-variables UI.
FIREBASE_ADMIN_CREDENTIALS_JSON=
# Firebase Storage is NOT used — uploaded files live in Cloudinary, so no
# bucket name is needed here.

# ---------------------------------------------------------------------------
# Cloudinary — file storage for every uploaded document/image
# ---------------------------------------------------------------------------
# Either paste the single "API environment variable" from the Cloudinary
# dashboard (Settings -> API Keys):
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...or set the three values below individually. If both are set, the
# individual values win.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder every upload is nested under in the media library.
CLOUDINARY_UPLOAD_FOLDER=mosaic

# ---------------------------------------------------------------------------
# ChromaDB (local persistent vector store — no separate server needed)
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=mosaic_items
